# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Admin Settings
# -----------------------------------------------------------------------------
# Comma-separated list of admin email addresses authorized to access /admin
ADMIN_EMAILS=admin@pfstudio.com.ar,facundo@pfstudio.com

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://pfstudio.com.ar

# -----------------------------------------------------------------------------
# Email Configuration (Resend / SMTP)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=ventas@pfstudio.com.ar

# Optional Nodemailer fallback
EMAIL_USER=contacto@pfstudio.com.ar
EMAIL_APP_PASSWORD=your-email-app-password

# -----------------------------------------------------------------------------
# Rate Limiting (Upstash Redis - Requerido en producción)
# Crea una base Redis gratuita en https://console.upstash.com/
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# -----------------------------------------------------------------------------
# Cron & Maintenance Security
# -----------------------------------------------------------------------------
CRON_SECRET=your-secure-random-cron-secret

